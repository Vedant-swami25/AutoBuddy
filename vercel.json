{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/garages",
      "destination": "/frontend/garage.html"
    },
    {
      "source": "/garage",
      "destination": "/frontend/garage.html"
    },
    {
      "source": "/garage.html",
      "destination": "/frontend/garage.html"
    },
    {
      "source": "/map",
      "destination": "/frontend/map.html"
    },
    {
      "source": "/map.html",
      "destination": "/frontend/map.html"
    },
    {
      "source": "/services",
      "destination": "/frontend/services.html"
    },
    {
      "source": "/services.html",
      "destination": "/frontend/services.html"
    },
    {
      "source": "/tracking",
      "destination": "/frontend/tracking.html"
    },
    {
      "source": "/tracking.html",
      "destination": "/frontend/tracking.html"
    },
    {
      "source": "/owner",
      "destination": "/frontend/owner-dashboard.html"
    },
    {
      "source": "/owner-dashboard",
      "destination": "/frontend/owner-dashboard.html"
    },
    {
      "source": "/owner-dashboard.html",
      "destination": "/frontend/owner-dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin-dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/frontend/admin-dashboard.html"
    },
    {
      "source": "/admin-dashboard.html",
      "destination": "/frontend/admin-dashboard.html"
    },
    {
      "source": "/partner",
      "destination": "/frontend/partner.html"
    },
    {
      "source": "/partner.html",
      "destination": "/frontend/partner.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/screenshots/(.*)",
      "destination": "/screenshots/$1"
    }
  ]
}
